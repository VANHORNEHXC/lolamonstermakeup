{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["src/app/admin/admin.css"],
      "linter": {
        "rules": {
          "style": { "noDescendingSpecificity": "off" }
        }
      }
    }
  ]
}
